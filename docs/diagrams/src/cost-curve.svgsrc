<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 460" width="900" height="460" font-family="Segoe UI, Calibri, Arial, sans-serif">
  <rect width="900" height="460" fill="#ffffff"/>
  <text x="20" y="24" font-size="14" font-weight="700" fill="#111">Custo de processamento por duração do vídeo (fps=1, PNG, conteúdo real)</text>
  <text x="20" y="42" font-size="11" fill="#666">Medições sequenciais no container fiapx-baseline, 6 vCPU · fonte: docs/evidence/19-curva-custo.txt e 20-status-curva.json</text>

  <line x1="70" y1="360" x2="860" y2="360" stroke="#333" stroke-width="1.2"/>
  <line x1="70" y1="70" x2="70" y2="360" stroke="#333" stroke-width="1.2"/>
  <line x1="860" y1="70" x2="860" y2="360" stroke="#c0392b" stroke-width="1.2"/>

  <line x1="70" y1="288" x2="860" y2="288" stroke="#eee"/>
  <line x1="70" y1="215" x2="860" y2="215" stroke="#eee"/>
  <line x1="70" y1="142" x2="860" y2="142" stroke="#eee"/>
  <line x1="70" y1="70" x2="860" y2="70" stroke="#eee"/>

  <text x="62" y="364" font-size="10" text-anchor="end" fill="#2c5aa0">0</text>
  <text x="62" y="292" font-size="10" text-anchor="end" fill="#2c5aa0">100</text>
  <text x="62" y="219" font-size="10" text-anchor="end" fill="#2c5aa0">200</text>
  <text x="62" y="146" font-size="10" text-anchor="end" fill="#2c5aa0">300</text>
  <text x="62" y="74" font-size="10" text-anchor="end" fill="#2c5aa0">400</text>
  <text x="20" y="60" font-size="11" font-weight="600" fill="#2c5aa0">ZIP (MB)</text>

  <text x="868" y="364" font-size="10" fill="#c0392b">0</text>
  <text x="868" y="292" font-size="10" fill="#c0392b">17,5</text>
  <text x="868" y="219" font-size="10" fill="#c0392b">35</text>
  <text x="868" y="146" font-size="10" fill="#c0392b">52,5</text>
  <text x="868" y="74" font-size="10" fill="#c0392b">70</text>
  <text x="806" y="60" font-size="11" font-weight="600" fill="#c0392b">resposta (s)</text>

  <text x="81" y="378" font-size="10" text-anchor="middle" fill="#444">12</text>
  <text x="108" y="392" font-size="10" text-anchor="middle" fill="#444">40</text>
  <text x="183" y="378" font-size="10" text-anchor="middle" fill="#444">120</text>
  <text x="296" y="378" font-size="10" text-anchor="middle" fill="#444">240</text>
  <text x="521" y="378" font-size="10" text-anchor="middle" fill="#444">480</text>
  <text x="838" y="378" font-size="10" text-anchor="middle" fill="#444">817</text>
  <text x="465" y="410" font-size="11" font-weight="600" text-anchor="middle" fill="#444">duração do vídeo de entrada (segundos)</text>

  <polyline points="81,326 108,314 183,282 296,234 521,138 838,63" fill="none" stroke="#2c5aa0" stroke-width="2.2"/>
  <circle cx="81" cy="326" r="4" fill="#2c5aa0"/>
  <circle cx="108" cy="314" r="4" fill="#2c5aa0"/>
  <circle cx="183" cy="282" r="4" fill="#2c5aa0"/>
  <circle cx="296" cy="234" r="4" fill="#2c5aa0"/>
  <circle cx="521" cy="138" r="4" fill="#2c5aa0"/>
  <circle cx="838" cy="63" r="5" fill="#ffffff" stroke="#2c5aa0" stroke-width="2.4"/>

  <polyline points="81,326 108,321 183,304 296,277 521,207 838,52" fill="none" stroke="#c0392b" stroke-width="2.2" stroke-dasharray="6 3"/>
  <circle cx="81" cy="326" r="3.4" fill="#c0392b"/>
  <circle cx="108" cy="321" r="3.4" fill="#c0392b"/>
  <circle cx="183" cy="304" r="3.4" fill="#c0392b"/>
  <circle cx="296" cy="277" r="3.4" fill="#c0392b"/>
  <circle cx="521" cy="207" r="3.4" fill="#c0392b"/>
  <circle cx="838" cy="52" r="4.4" fill="#ffffff" stroke="#c0392b" stroke-width="2.2"/>

  <text x="530" y="128" font-size="10" fill="#2c5aa0">265 MB</text>
  <text x="826" y="80" font-size="10" text-anchor="end" fill="#2c5aa0">368 MB</text>
  <text x="530" y="200" font-size="10" fill="#c0392b">29,6 s</text>
  <text x="826" y="104" font-size="10" text-anchor="end" font-weight="600" fill="#c0392b">67 s</text>
  <text x="826" y="118" font-size="9.5" text-anchor="end" fill="#c0392b">timeout de proxy já excedido</text>

  <line x1="70" y1="304" x2="860" y2="304" stroke="#999" stroke-width="1" stroke-dasharray="3 3"/>
  <text x="76" y="300" font-size="9.5" fill="#777">limite prático de 30 s para requisição HTTP síncrona</text>

  <rect x="70" y="422" width="18" height="3" fill="#2c5aa0"/>
  <text x="96" y="428" font-size="10.5" fill="#333">tamanho do ZIP entregue</text>
  <rect x="290" y="422" width="18" height="3" fill="#c0392b"/>
  <text x="316" y="428" font-size="10.5" fill="#333">tempo até a resposta HTTP</text>
  <circle cx="560" cy="424" r="4.4" fill="#ffffff" stroke="#555" stroke-width="2"/>
  <text x="574" y="428" font-size="10.5" fill="#333">ponto medido na sessão anterior (Fase 4.mp4, 817 frames)</text>

  <rect x="92" y="84" width="336" height="88" rx="4" fill="#fafafa" stroke="#bbb"/>
  <text x="106" y="102" font-size="10.5" font-weight="700" fill="#111">Relações lineares medidas</text>
  <text x="106" y="119" font-size="10" fill="#333">1 frame por segundo de vídeo (fps=1 fixo no código)</text>
  <text x="106" y="134" font-size="10" fill="#333">cerca de 0,55 MB de ZIP por segundo de vídeo</text>
  <text x="106" y="149" font-size="10" fill="#333">cerca de 0,062 s de processamento por frame (6% da duração)</text>
  <text x="106" y="164" font-size="10" font-weight="600" fill="#8b2500">extrapolação: 1 h de vídeo = 3600 frames = 2 GB = 3,7 min</text>
</svg>
